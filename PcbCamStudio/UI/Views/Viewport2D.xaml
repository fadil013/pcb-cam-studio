<UserControl x:Class="PcbCamStudio.UI.Views.Viewport2D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF">

    <Grid Background="#FF111111">
        <!-- SkiaSharp canvas — PCB 2D preview rendered here -->
        <skia:SKElement x:Name="SkiaCanvas"
                        PaintSurface="SkiaCanvas_PaintSurface"
                        MouseWheel="SkiaCanvas_MouseWheel"
                        MouseMove="SkiaCanvas_MouseMove"
                        MouseDown="SkiaCanvas_MouseDown"
                        MouseUp="SkiaCanvas_MouseUp"/>

        <!-- Coordinates overlay -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                    VerticalAlignment="Bottom" Margin="8">
            <TextBlock x:Name="CoordsText" Text="X: 0.000   Y: 0.000"
                       Foreground="#FF9E9E9E" FontFamily="Consolas" FontSize="11"/>
        </StackPanel>

        <!-- Zoom overlay -->
        <TextBlock x:Name="ZoomText" Text="100%"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Foreground="#FF9E9E9E" FontSize="11" Margin="8"/>
    </Grid>
</UserControl>
