<Window x:Class="PcbCamStudio.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PCB CAM Studio v1.0"
        Height="820" Width="1400"
        MinHeight="600" MinWidth="1100"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Layer item style -->
        <Style x:Key="LayerItem" TargetType="Border">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Padding"          Value="8,5"/>
            <Setter Property="Margin"           Value="0,1"/>
            <Setter Property="CornerRadius"     Value="3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Menu bar -->
            <RowDefinition Height="50"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════
             ROW 0 — MENU BAR
             ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#FF1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="4,0">
                <MenuItem Header="File" Foreground="{StaticResource TextPrimary}">
                    <MenuItem Header="Open Gerber File..."  Foreground="{StaticResource TextPrimary}"/>
                    <MenuItem Header="Open Drill File..."   Foreground="{StaticResource TextPrimary}"/>
                    <Separator/>
                    <MenuItem Header="Save Project"         Foreground="{StaticResource TextPrimary}"/>
                    <MenuItem Header="Open Project..."      Foreground="{StaticResource TextPrimary}"/>
                    <Separator/>
                    <MenuItem Header="Export G-code..."     Foreground="{StaticResource TextPrimary}"/>
                    <Separator/>
                    <MenuItem Header="Exit"                 Foreground="{StaticResource TextPrimary}"/>
                </MenuItem>
                <MenuItem Header="View" Foreground="{StaticResource TextPrimary}">
                    <MenuItem Header="2D View"   Foreground="{StaticResource TextPrimary}" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="3D View"   Foreground="{StaticResource TextPrimary}" IsCheckable="True"/>
                    <Separator/>
                    <MenuItem Header="Zoom Fit"  Foreground="{StaticResource TextPrimary}"/>
                    <MenuItem Header="Zoom Reset" Foreground="{StaticResource TextPrimary}"/>
                </MenuItem>
                <MenuItem Header="Machine" Foreground="{StaticResource TextPrimary}">
                    <MenuItem Header="Connect..."           Foreground="{StaticResource TextPrimary}"/>
                    <MenuItem Header="Disconnect"           Foreground="{StaticResource TextPrimary}"/>
                    <Separator/>
                    <MenuItem Header="Machine Settings..."  Foreground="{StaticResource TextPrimary}"/>
                </MenuItem>
                <MenuItem Header="Help" Foreground="{StaticResource TextPrimary}">
                    <MenuItem Header="About PCB CAM Studio" Foreground="{StaticResource TextPrimary}"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- ══════════════════════════════════════════════
             ROW 1 — TOOLBAR
             ══════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#FF252526" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">

                <!-- Import -->
                <Button Style="{StaticResource AccentBtn}" Width="130" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Import Files"/>
                    </StackPanel>
                </Button>

                <Separator Width="1" Height="30" Background="{StaticResource BorderBrush}" Margin="4,0"/>

                <!-- Generate -->
                <Button Style="{StaticResource BaseBtn}" Width="150" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Generate Toolpaths"/>
                    </StackPanel>
                </Button>

                <!-- Export G-code -->
                <Button Style="{StaticResource BaseBtn}" Width="130" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Export G-code"/>
                    </StackPanel>
                </Button>

                <Separator Width="1" Height="30" Background="{StaticResource BorderBrush}" Margin="4,0"/>

                <!-- One-Click Job -->
                <Button Style="{StaticResource GreenBtn}" Width="140" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="One-Click Job"/>
                    </StackPanel>
                </Button>

                <Separator Width="1" Height="30" Background="{StaticResource BorderBrush}" Margin="4,0"/>

                <!-- View toggle -->
                <ToggleButton x:Name="Btn2D" IsChecked="True" Width="50" Height="32" Margin="0,0,4,0"
                              Background="#FF007ACC" BorderBrush="#FF007ACC" Foreground="White"
                              FontWeight="SemiBold" FontSize="12" Cursor="Hand">2D</ToggleButton>
                <ToggleButton x:Name="Btn3D" Width="50" Height="32"
                              Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}"
                              Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" Cursor="Hand">3D</ToggleButton>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             ROW 2 — MAIN CONTENT (3 columns)
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200"/>  <!-- Left panel -->
                <ColumnDefinition Width="5"/>                    <!-- Splitter -->
                <ColumnDefinition Width="*"/>                    <!-- Center preview -->
                <ColumnDefinition Width="5"/>                    <!-- Splitter -->
                <ColumnDefinition Width="260" MinWidth="220"/>  <!-- Right panel -->
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────────────
                 LEFT PANEL — Files + CAM Settings
                 ───────────────────────────────────────── -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,12">

                        <!-- FILES SECTION -->
                        <TextBlock Text="IMPORTED FILES" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#FF4CAF50" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="top_copper.gtl" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="Copper Layer" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="14,1,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#FFFF9800" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="board.gko" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="Board Outline" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="14,1,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#FF00B4D8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="drill.drl" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="Drill File  —  3 sizes, 24 holes" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="14,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource BaseBtn}" Height="30" Margin="0,4,0,0" FontSize="11">
                            + Add File
                        </Button>

                        <Separator Margin="0,12"/>

                        <!-- CAM SETTINGS -->
                        <TextBlock Text="CAM SETTINGS" Style="{StaticResource SectionHeader}"/>

                        <!-- Isolation Routing -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Isolation Routing" Foreground="{StaticResource TextPrimary}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tool Diameter (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="0.10" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Passes" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="1">
                                        <ComboBoxItem>1</ComboBoxItem>
                                        <ComboBoxItem>2</ComboBoxItem>
                                        <ComboBoxItem>3</ComboBoxItem>
                                        <ComboBoxItem>4</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cut Depth (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="-0.10" TextAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Drilling -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Drilling" Foreground="{StaticResource TextPrimary}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Drill Speed (mm/min)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="100" TextAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Safe Z (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="2.00" TextAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Board Cutout -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Board Cutout" Foreground="{StaticResource TextPrimary}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Board Thickness (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="1.60" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Depth per Pass (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="0.50" TextAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Holding Tabs" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="1">
                                        <ComboBoxItem>2</ComboBoxItem>
                                        <ComboBoxItem>4</ComboBoxItem>
                                        <ComboBoxItem>6</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource AccentBtn}" Height="34" FontSize="12">
                            ⚙  Generate All Toolpaths
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

            <!-- ─────────────────────────────────────────
                 CENTER — Preview Viewport
                 ───────────────────────────────────────── -->
            <Grid Grid.Column="2" Background="{StaticResource BgDark}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview Canvas Area -->
                <Border Grid.Row="0" Background="#FF111111" Margin="8">
                    <Grid>
                        <!-- Placeholder grid / crosshair -->
                        <Canvas x:Name="PreviewCanvas" ClipToBounds="True">
                            <!-- Grid lines (subtle) -->
                            <Line X1="0" Y1="0" X2="0" Y2="2000" Stroke="#FF1E1E1E" StrokeThickness="1" Canvas.Left="100"/>
                            <Line X1="0" Y1="0" X2="0" Y2="2000" Stroke="#FF1E1E1E" StrokeThickness="1" Canvas.Left="200"/>
                            <Line X1="0" Y1="0" X2="0" Y2="2000" Stroke="#FF1E1E1E" StrokeThickness="1" Canvas.Left="300"/>
                        </Canvas>

                        <!-- Empty state hint -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3">
                            <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="Import Gerber and Drill files to begin"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Drag &amp; drop files here or click Import Files"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Corner coordinates -->
                        <TextBlock Text="X: 0.000   Y: 0.000" Foreground="{StaticResource TextSecondary}"
                                   FontSize="10" FontFamily="Consolas"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                   Margin="10,0,0,8"/>
                        <TextBlock Text="Zoom: 100%" Foreground="{StaticResource TextSecondary}"
                                   FontSize="10"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,10,8"/>
                    </Grid>
                </Border>

                <!-- Job Progress Bar -->
                <Border Grid.Row="1" Background="#FF252526" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="12,8" Margin="8,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Job Progress" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                        <ProgressBar Grid.Column="1" Value="0" Maximum="100" Height="8"
                                     Background="#FF3C3C3C" Foreground="{StaticResource AccentGreen}"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="2" Text="0%" Foreground="{StaticResource TextPrimary}"
                                   FontSize="12" FontFamily="Consolas" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Time left: --:--" Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

            <!-- ─────────────────────────────────────────
                 RIGHT PANEL — Machine Connection + Control
                 ───────────────────────────────────────── -->
            <Border Grid.Column="4" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,12">

                        <!-- CONNECTION -->
                        <TextBlock Text="MACHINE CONNECTION" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- Connection type -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="USB Serial" Foreground="{StaticResource TextPrimary}"
                                                 FontSize="12" IsChecked="True" VerticalContentAlignment="Center"/>
                                    <RadioButton Grid.Column="1" Content="WiFi" Foreground="{StaticResource TextPrimary}"
                                                 FontSize="12" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1">
                                        <ComboBoxItem>COM3</ComboBoxItem>
                                        <ComboBoxItem>COM4</ComboBoxItem>
                                        <ComboBoxItem>COM5</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Baud Rate" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="0">
                                        <ComboBoxItem>115200</ComboBoxItem>
                                        <ComboBoxItem>250000</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <Button Style="{StaticResource GreenBtn}" Height="32" FontSize="12">
                                    🔌  Connect
                                </Button>

                                <!-- Status indicator -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="#FF666666" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Not Connected" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- POSITION -->
                        <TextBlock Text="MACHINE POSITION" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#FF1A1A1A" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="X" Foreground="{StaticResource AccentRed}" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="0.000" Foreground="{StaticResource TextPrimary}" FontSize="16"
                                               FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Y" Foreground="{StaticResource AccentGreen}" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="0.000" Foreground="{StaticResource TextPrimary}" FontSize="16"
                                               FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Z" Foreground="{StaticResource Accent}" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="0.000" Foreground="{StaticResource TextPrimary}" FontSize="16"
                                               FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- JOG CONTROLS -->
                        <TextBlock Text="JOG CONTROL" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- XY Jog pad -->
                                <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource JogBtn}" Content="▲" ToolTip="Y+"/>
                                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource JogBtn}" Content="◄" ToolTip="X-"/>
                                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource JogBtn}" Content="⌂" ToolTip="XY Home" FontSize="12"/>
                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource JogBtn}" Content="►" ToolTip="X+"/>
                                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource JogBtn}" Content="▼" ToolTip="Y-"/>

                                    <!-- Z axis -->
                                    <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource JogBtn}" Content="▲" ToolTip="Z+" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Z" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource JogBtn}" Content="▼" ToolTip="Z-" Foreground="{StaticResource Accent}"/>
                                </Grid>

                                <!-- Step size -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Step:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="1">
                                        <ComboBoxItem>0.1 mm</ComboBoxItem>
                                        <ComboBoxItem>1.0 mm</ComboBoxItem>
                                        <ComboBoxItem>10 mm</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- MACHINE ACTIONS -->
                        <TextBlock Text="MACHINE ACTIONS" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource BaseBtn}" Height="30" FontSize="11">🏠 Home</Button>
                                    <Button Grid.Column="2" Style="{StaticResource BaseBtn}" Height="30" FontSize="11">📍 Set Zero</Button>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource GreenBtn}" Height="30" FontSize="11">▶ Start</Button>
                                    <Button Grid.Column="2" Style="{StaticResource OrangeBtn}" Height="30" FontSize="11">⏸ Pause</Button>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource AccentBtn}" Height="30" FontSize="11">↩ Resume</Button>
                                    <Button Grid.Column="2" Style="{StaticResource BaseBtn}" Height="30" FontSize="11">⏹ Stop</Button>
                                </Grid>

                                <!-- Emergency Stop -->
                                <Button Style="{StaticResource RedBtn}" Height="44" FontSize="15" FontWeight="Bold">
                                    ⚠  EMERGENCY STOP
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- CONSOLE -->
                        <TextBlock Text="CONSOLE" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#FF111111" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Height="100" Margin="0,0,0,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#FF4EC9B0"
                                           Padding="6" TextWrapping="Wrap">
                                    <Run Text="> Machine ready." Foreground="#FF4EC9B0"/>
                                    <LineBreak/>
                                    <Run Text="> Waiting for connection..." Foreground="#FF9E9E9E"/>
                                </TextBlock>
                            </ScrollViewer>
                        </Border>

                        <!-- Manual G-code send -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="" FontFamily="Consolas" FontSize="11"
                                     Height="28" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Style="{StaticResource AccentBtn}" Height="28"
                                    FontSize="11" Padding="0">Send</Button>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════
             ROW 3 — STATUS BAR
             ══════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#FF007ACC" BorderThickness="0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="● Ready" Foreground="White" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="2" Text="No file loaded" Foreground="#FFB3D9FF"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="3" Text="Machine: Not Connected" Foreground="#FFB3D9FF"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="4" Text="PCB CAM Studio v1.0" Foreground="#FFB3D9FF"
                           FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
